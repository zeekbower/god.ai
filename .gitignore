# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sibling infra, physically relocated here (2026-07-28) from
# /home/notds/code/WEBSITES/ so everything lives under one path, but not part
# of this repo's own source: NodeBB and Wiki.js's own upstream projects (fetched
# fresh by scripts/setup.sh, not vendored here), mongod's data files, and DB
# backups. bots/ is NOT excluded wholesale (see below) — the persona files and
# control scripts are authored project content, not disposable data.
/forum/
/forum-data/
/wiki/
/wiki-data/
/backups/

# Bot credentials (real NodeBB/Wiki.js passwords) — everything else in bots/
# (persona .md files, PROTOCOL.md, CYCLE_LOG.md, control scripts) IS tracked.
/bots/*.env
